<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Dataliza header. Shipped inactive on purpose: it is switched on from the website editor
        (Header > Template > Dataliza), which also deactivates the other header templates. Two
        active templates replacing `//header//nav` would make the second xpath fail.
        The editor option lives in static/src/builder/header.xml.
    -->

    <!-- Mobile navbar (offcanvas). Separate template so `is_mobile` does not leak into the desktop navbar. -->
    <template id="dz_header_mobile" name="Dataliza Header Mobile">
        <t t-set="is_mobile" t-value="True"/>
        <t t-call="website.navbar"
            _navbar_classes.f="o_header_mobile dz-header dz-header--mobile d-block d-lg-none"
            _navbar_expand_class.f=""
            _navbar_name.f="Mobile">
            <div class="o_main_nav container flex-wrap justify-content-between">
                <div class="d-flex flex-grow-1 align-items-center">
                    <a href="/" class="navbar-brand dz-brand">dataliza<span class="dz-brand__reg">®</span></a>
                </div>
                <button class="nav-link btn p-2 o_not_editable dz-header__toggler" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#top_menu_collapse_mobile"
                    aria-controls="top_menu_collapse_mobile" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"/>
                </button>
                <div class="offcanvas offcanvas-end o_navbar_mobile" id="top_menu_collapse_mobile">
                    <div class="offcanvas-header justify-content-end o_not_editable">
                        <button type="button" class="nav-link btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"/>
                    </div>
                    <div class="offcanvas-body d-flex flex-column justify-content-between h-100 w-100 pt-0">
                        <ul class="navbar-nav">
                            <li>
                                <t t-set="is_vertical_nav" t-valuef="True"/>
                                <t t-call="website.navbar_nav" _no_autohide_menu_mobile.f="True">
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-call="website.submenu"
                                            item_class.f="nav-item border-top"
                                            link_class.f="nav-link p-3 text-wrap"
                                            dropdown_toggler_classes.f="d-flex justify-content-between align-items-center"
                                            dropdown_menu_classes.f="position-relative rounded-0 o_dropdown_without_offset"/>
                                    </t>
                                </t>
                            </li>
                        </ul>
                        <ul class="navbar-nav gap-2 mt-3 w-100">
                            <t t-call="portal.placeholder_user_sign_in"
                                _link_class.f="nav-link o_nav_link_btn w-100 border text-center"/>
                            <t t-call="portal.user_dropdown"
                                _icon="true"
                                _user_name="true"
                                _user_name_class.f="me-auto small"
                                _link_class.f="nav-link d-flex align-items-center border-0"
                                _icon_class.f="me-2"
                                _item_class.f="dropdown dropup"
                                _dropdown_menu_class.f="w-100"/>
                            <li class="nav-item">
                                <a href="/contactanos" class="btn btn-primary dz-header__cta w-100">Contáctanos</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Header layout -->
    <template id="template_header_dataliza" inherit_id="website.layout" name="Template Header Dataliza" active="False">
        <xpath expr="//header//nav" position="replace">
            <t t-call="website.navbar">
                <t t-set="_navbar_classes" t-valuef="dz-header d-none d-lg-block"/>

                <div id="o_main_nav" t-attf-class="o_main_nav #{header_content_width}">
                    <!-- Wordmark 'dataliza®' (left) | plain Poppins links (centre) | black pill CTA (right).
                         The two side blocks share the free space equally so the links stay centred. -->
                    <div class="dz-header__side">
                        <a href="/" class="navbar-brand dz-brand">dataliza<span class="dz-brand__reg">®</span></a>
                    </div>
                    <t t-call="website.navbar_nav" _nav_class.f="dz-header__nav justify-content-center">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <t t-call="website.submenu"
                                item_class.f="nav-item"
                                link_class.f="nav-link"/>
                        </t>
                    </t>
                    <div class="dz-header__side dz-header__side--end">
                        <ul class="navbar-nav align-items-center gap-2 flex-shrink-0 justify-content-end ps-3">
                            <t t-call="website.placeholder_header_language_selector"
                                _btn_class.f="nav-link"
                                _dropdown_menu_class.f="dropdown-menu-end"/>
                            <t t-call="portal.placeholder_user_sign_in"
                                _link_class.f="nav-link o_nav_link_btn border px-3"/>
                            <t t-call="portal.user_dropdown"
                                _user_name="True"
                                _item_class.f="dropdown"
                                _link_class.f="nav-link border-0"
                                _dropdown_menu_class.f="dropdown-menu-end"/>
                            <!-- Black pill CTA -->
                            <li class="nav-item">
                                <a href="/contactanos" class="btn btn-primary dz-header__cta">Contáctanos</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </t>
            <t t-call="theme_dataliza.dz_header_mobile"/>
        </xpath>
    </template>
</odoo>
