<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        S12 hero: black rounded card inside the container. Corners: wordmark (top-left),
        services (top-right), tagline (bottom-left), white contact card (bottom-right).
        The canvas (faint ASCII plasma) is drawn by the theme_dataliza.ascii_hero interaction and never holds text.
    -->
    <template id="s_dz_ascii_hero" name="Dataliza ASCII Hero">
        <section class="s_dz_ascii_hero pt16 pb16" data-snippet="s_dz_ascii_hero" data-name="ASCII Hero">
            <div class="container">
                <div class="s_dz_ascii_hero__card dz-dark">
                    <canvas class="s_dz_ascii_hero__canvas o_not_editable" aria-hidden="true" contenteditable="false"/>
                    <div class="s_dz_ascii_hero__brand">
                        <h1 class="s_dz_ascii_hero__wordmark">dataliza<span class="s_dz_ascii_hero__reg">®</span></h1>
                        <p class="s_dz_ascii_hero__sub">Odoo Silver Partner</p>
                    </div>
                    <ul class="s_dz_ascii_hero__services">
                        <li>Implementación de Odoo ERP</li>
                        <li>Sistema CRM</li>
                        <li>Tienda en línea</li>
                        <li>MRP</li>
                        <li>Soporte y pólizas</li>
                    </ul>
                    <div class="s_dz_ascii_hero__tagline">
                        <p class="s_dz_ascii_hero__claim">decide con datos</p>
                        <p class="s_dz_ascii_hero__lead">Integramos a tu empresa odoo ERP para que conozcas la información más relevante de tu negocio y tomes mejores decisiones.</p>
                    </div>
                    <div class="s_dz_ascii_hero__contact dz-light">
                        <p class="dz-label">Odoo Silver Partner</p>
                        <p class="s_dz_ascii_hero__contact-line">Implementando Odoo desde 2020</p>
                        <a href="/contactanos" class="btn btn-primary">Hablemos</a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
