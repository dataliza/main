                            <a href="/sistema-erp" class="dz-label">Descubre más →</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3 s_dz_features__col">
                        <div class="dz-cell dz-marks h-100">
                            <div class="s_dz_features__media">
                                <img src="/theme_dataliza/static/src/img/dz/dz-mod-mrp-circuito.webp" alt="Placa de circuitos de una computadora" loading="lazy" width="900" height="600"/>
