<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_dz_features" name="Dataliza Features">
        <section class="s_dz_features pt64 pb64" data-snippet="s_dz_features" data-name="Features">
            <div class="container">
                <div class="dz-head">
                    <h2 class="dz-title">Módulos</h2>
                    <p class="dz-head__intro">Como Odoo Silver Partner, implementamos los módulos que tu empresa necesita.</p>
                </div>
                <!-- Asymmetric mosaic (user choice, L15): ERP tall photo, CRM black, Tienda photo, MRP wide light. -->
                <div class="s_dz_features__mosaic">
                    <article class="s_dz_features__card s_dz_features__card--erp s_dz_features__is-photo dz-dark dz-lift">
                        <img class="s_dz_features__bg" src="/theme_dataliza/static/src/img/dz/dz-mod-erp-color.webp" alt="Servidores iluminados en azul dentro de un centro de datos" loading="lazy" width="1200" height="800"/>
                        <p class="s_dz_features__num">01</p>
                        <div class="s_dz_features__copy">
                            <h3>Sistema ERP</h3>
                            <p>Suite integrada de aplicaciones empresariales de código abierto. Su enfoque modular te permite seleccionar y personalizar los módulos según tus necesidades.</p>
                            <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                        </div>
                    </article>
                    <article class="s_dz_features__card s_dz_features__card--crm s_dz_features__is-photo dz-dark dz-lift">
                        <img class="s_dz_features__bg" src="/theme_dataliza/static/src/img/dz/dz-mod-crm-color.webp" alt="Lupa sobre gráficas de colores que analizan datos de clientes" loading="lazy" width="900" height="600"/>
                        <p class="s_dz_features__num">02</p>
                        <div class="s_dz_features__copy">
                            <h3>Sistema CRM</h3>
                            <p>Gestiona y mejora tus interacciones con clientes y clientes potenciales desde una herramienta integral.</p>
                            <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                        </div>
                    </article>
                    <article class="s_dz_features__card s_dz_features__card--tienda s_dz_features__is-photo dz-dark dz-lift">
                        <img class="s_dz_features__bg" src="/theme_dataliza/static/src/img/dz/dz-mod-tienda-color.webp" alt="Persona comprando en línea desde un teléfono con una tarjeta en la mano" loading="lazy" width="900" height="600"/>
                        <p class="s_dz_features__num">03</p>
                        <div class="s_dz_features__copy">
                            <h3>Tienda en línea</h3>
                            <p>Crea y gestiona tu tienda en línea, integrada con el resto de tu sistema de gestión empresarial.</p>
                            <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                        </div>
                    </article>
                    <article class="s_dz_features__card s_dz_features__card--mrp dz-lift">
                        <div class="s_dz_features__main">
                            <p class="s_dz_features__num">04</p>
                            <div class="s_dz_features__copy">
                                <h3>MRP</h3>
                                <p>Planifica, programa y controla la producción de manera eficiente.</p>
                                <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                            </div>
                        </div>
                        <figure class="s_dz_features__side">
                            <img src="/theme_dataliza/static/src/img/dz/dz-mod-mrp-circuito.webp" alt="Placa de circuitos de una computadora" loading="lazy" width="900" height="600"/>
                        </figure>
                    </article>
                </div>
                <div class="s_dz_features__industries pt48">
                    <p class="dz-label">Industrias que atendemos</p>
                    <!-- Card Beam (user choice, L21): the strip slides through a beam and each card turns into code. Static grid without JS. -->
                    <div class="s_dz_features__beam mt-3">
                        <canvas class="s_dz_features__beam-fx" aria-hidden="true"></canvas>
                        <span class="s_dz_features__beam-bar" aria-hidden="true"></span>
                        <div class="s_dz_features__beam-track" role="list">
                            <article class="s_dz_features__ic" role="listitem">
                                <div class="s_dz_features__ic-front">
                                    <span class="s_dz_features__ic-mark" aria-hidden="true">dataliza<sup>®</sup></span>
                                    <div class="s_dz_features__ic-foot">
                                        <p class="s_dz_features__ic-name">Manufactura</p>
                                        <span class="s_dz_features__ic-idx" aria-hidden="true">01</span>
                                    </div>
                                </div>
                                <div class="s_dz_features__ic-code" aria-hidden="true"></div>
                            </article>
                            <article class="s_dz_features__ic" role="listitem">
                                <div class="s_dz_features__ic-front">
                                    <span class="s_dz_features__ic-mark" aria-hidden="true">dataliza<sup>®</sup></span>
                                    <div class="s_dz_features__ic-foot">
                                        <p class="s_dz_features__ic-name">Alimentos y hospitalidad</p>
                                        <span class="s_dz_features__ic-idx" aria-hidden="true">02</span>
                                    </div>
                                </div>
                                <div class="s_dz_features__ic-code" aria-hidden="true"></div>
                            </article>
                            <article class="s_dz_features__ic" role="listitem">
                                <div class="s_dz_features__ic-front">
                                    <span class="s_dz_features__ic-mark" aria-hidden="true">dataliza<sup>®</sup></span>
                                    <div class="s_dz_features__ic-foot">
                                        <p class="s_dz_features__ic-name">Comercio mayorista y minorista</p>
                                        <span class="s_dz_features__ic-idx" aria-hidden="true">03</span>
                                    </div>
                                </div>
                                <div class="s_dz_features__ic-code" aria-hidden="true"></div>
                            </article>
                            <article class="s_dz_features__ic" role="listitem">
                                <div class="s_dz_features__ic-front">
                                    <span class="s_dz_features__ic-mark" aria-hidden="true">dataliza<sup>®</sup></span>
                                    <div class="s_dz_features__ic-foot">
                                        <p class="s_dz_features__ic-name">Servicios</p>
                                        <span class="s_dz_features__ic-idx" aria-hidden="true">04</span>
                                    </div>
                                </div>
                                <div class="s_dz_features__ic-code" aria-hidden="true"></div>
                            </article>
                            <article class="s_dz_features__ic" role="listitem">
                                <div class="s_dz_features__ic-front">
                                    <span class="s_dz_features__ic-mark" aria-hidden="true">dataliza<sup>®</sup></span>
                                    <div class="s_dz_features__ic-foot">
                                        <p class="s_dz_features__ic-name">Construcción</p>
                                        <span class="s_dz_features__ic-idx" aria-hidden="true">05</span>
                                    </div>
                                </div>
                                <div class="s_dz_features__ic-code" aria-hidden="true"></div>
                            </article>
                            <article class="s_dz_features__ic" role="listitem">
                                <div class="s_dz_features__ic-front">
                                    <span class="s_dz_features__ic-mark" aria-hidden="true">dataliza<sup>®</sup></span>
                                    <div class="s_dz_features__ic-foot">
                                        <p class="s_dz_features__ic-name">Salud</p>
                                        <span class="s_dz_features__ic-idx" aria-hidden="true">06</span>
                                    </div>
                                </div>
                                <div class="s_dz_features__ic-code" aria-hidden="true"></div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
