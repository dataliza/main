<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_dz_features" name="Dataliza Features">
        <section class="s_dz_features dz-dark pt64 pb64" data-snippet="s_dz_features" data-name="Features">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 pb32">
                        <p class="dz-label">Módulos</p>
