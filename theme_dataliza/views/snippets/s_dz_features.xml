<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_dz_features" name="Dataliza Features">
        <section class="s_dz_features pt64 pb64" data-snippet="s_dz_features" data-name="Features">
            <div class="container">
                <div class="dz-head">
                    <h2 class="dz-title">Módulos</h2>
                    <p class="dz-head__intro">Como Odoo Silver Partner, implementamos los módulos que tu empresa necesita.</p>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <div class="dz-card dz-lift s_dz_features__card h-100">
                            <div class="s_dz_features__media">
                                <img src="/theme_dataliza/static/src/img/dz/dz-mod-erp-servidores.webp" alt="Servidores en un centro de datos" loading="lazy" width="900" height="600"/>
                            </div>
                            <div class="s_dz_features__body">
                                <p class="dz-label">01</p>
                                <h3>Sistema ERP</h3>
                                <p>Suite integrada de aplicaciones empresariales de código abierto. Su enfoque modular te permite seleccionar y personalizar los módulos según tus necesidades.</p>
                                <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="dz-card dz-lift s_dz_features__card h-100">
                            <div class="s_dz_features__media">
                                <img src="/theme_dataliza/static/src/img/dz/dz-mod-crm-datos.webp" alt="Código y datos proyectados sobre una persona" loading="lazy" width="900" height="600"/>
                            </div>
                            <div class="s_dz_features__body">
                                <p class="dz-label">02</p>
                                <h3>Sistema CRM</h3>
                                <p>Gestiona y mejora tus interacciones con clientes y clientes potenciales desde una herramienta integral.</p>
                                <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="dz-card dz-lift s_dz_features__card h-100">
                            <div class="s_dz_features__media">
                                <img src="/theme_dataliza/static/src/img/dz/dz-mod-tienda-codigo.webp" alt="Código en la pantalla de una computadora portátil" loading="lazy" width="900" height="600"/>
                            </div>
                            <div class="s_dz_features__body">
                                <p class="dz-label">03</p>
                                <h3>Tienda en línea</h3>
                                <p>Crea y gestiona tu tienda en línea, integrada con el resto de tu sistema de gestión empresarial.</p>
                                <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="dz-card dz-lift s_dz_features__card h-100">
                            <div class="s_dz_features__media">
                                <img src="/theme_dataliza/static/src/img/dz/dz-mod-mrp-circuito.webp" alt="Placa de circuitos de una computadora" loading="lazy" width="900" height="600"/>
                            </div>
                            <div class="s_dz_features__body">
                                <p class="dz-label">04</p>
                                <h3>MRP</h3>
                                <p>Planifica, programa y controla la producción de manera eficiente.</p>
                                <a href="/sistema-erp" class="btn btn-primary">Descubre más</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="s_dz_features__industries pt48">
                    <p class="dz-label">Industrias que atendemos</p>
                    <div class="row g-3 mt-1">
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="dz-card s_dz_features__industry h-100"><p>Manufactura</p></div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="dz-card s_dz_features__industry h-100"><p>Alimentos y hospitalidad</p></div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="dz-card s_dz_features__industry h-100"><p>Comercio mayorista y minorista</p></div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="dz-card s_dz_features__industry h-100"><p>Servicios</p></div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="dz-card s_dz_features__industry h-100"><p>Construcción</p></div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="dz-card s_dz_features__industry h-100"><p>Salud</p></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
