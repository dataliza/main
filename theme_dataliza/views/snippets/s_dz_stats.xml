<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- S12 light credentials band: four white rounded figure cells on the grey page. Figures are approved in S11 (see the spec). No seal or offices line (user, L13). -->
    <template id="s_dz_stats" name="Dataliza Stats">
        <section class="s_dz_stats pt48 pb48" data-snippet="s_dz_stats" data-name="Stats">
            <div class="container">
                <div class="dz-head">
                    <h2 class="dz-title">Credenciales</h2>
                    <p class="dz-head__intro">Cifras que respaldan nuestro trabajo.</p>
                </div>
                <div class="row g-3">
                    <!-- Final values are the real text; the dz_stats interaction only animates them. -->
                    <div class="col-6 col-lg-3">
                        <div class="dz-card s_dz_stats__cell">
                            <p class="s_dz_stats__num">50+</p>
                            <p class="s_dz_stats__label">empresas confían en nosotros</p>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="dz-card s_dz_stats__cell">
                            <p class="s_dz_stats__num">84 %</p>
                            <p class="s_dz_stats__label">retención de clientes</p>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="dz-card s_dz_stats__cell">
                            <p class="s_dz_stats__num">100+</p>
                            <p class="s_dz_stats__label">usuarios en un solo proyecto</p>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="dz-card s_dz_stats__cell">
                            <p class="s_dz_stats__num">5+</p>
                            <p class="s_dz_stats__label">años implementando Odoo (desde 2020)</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
