<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- theme.ir.asset records are copied to ir.asset only for the website where the theme is installed. -->
    <record id="primary_variables_scss" model="theme.ir.asset">
        <field name="key">theme_dataliza.primary_variables_scss</field>
        <field name="name">Dataliza primary variables SCSS</field>
        <field name="bundle">web._assets_primary_variables</field>
        <field name="path">theme_dataliza/static/src/scss/primary_variables.scss</field>
    </record>
    <record id="frontend_scss" model="theme.ir.asset">
        <field name="key">theme_dataliza.frontend_scss</field>
        <field name="name">Dataliza frontend SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/scss/dataliza.scss</field>
    </record>
    <record id="layout_scss" model="theme.ir.asset">
        <field name="key">theme_dataliza.layout_scss</field>
        <field name="name">Dataliza header and footer SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/scss/dz_layout.scss</field>
    </record>
    <record id="snippets_scss" model="theme.ir.asset">
        <field name="key">theme_dataliza.snippets_scss</field>
        <field name="name">Dataliza snippets SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/scss/dz_snippets.scss</field>
    </record>
    <record id="ascii_hero_js" model="theme.ir.asset">
        <field name="key">theme_dataliza.ascii_hero_js</field>
        <field name="name">Dataliza ASCII hero interaction</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/interactions/ascii_hero.js</field>
    </record>
    <record id="sections_scss" model="theme.ir.asset">
        <field name="key">theme_dataliza.sections_scss</field>
        <field name="name">Dataliza home sections SCSS (stats, features, steps, trust)</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/scss/dz_sections.scss</field>
    </record>
    <record id="dz_stats_js" model="theme.ir.asset">
        <field name="key">theme_dataliza.dz_stats_js</field>
        <field name="name">Dataliza stats count-up interaction</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/interactions/dz_stats.js</field>
    </record>
    <record id="dz_reveal_js" model="theme.ir.asset">
        <field name="key">theme_dataliza.dz_reveal_js</field>
        <field name="name">Dataliza scroll reveal interaction</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/interactions/dz_reveal.js</field>
    </record>
    <record id="dz_pixel_cards_js" model="theme.ir.asset">
        <field name="key">theme_dataliza.dz_pixel_cards_js</field>
        <field name="name">Dataliza pixel hover cards interaction</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/interactions/dz_pixel_cards.js</field>
    </record>
    <record id="dz_industry_beam_js" model="theme.ir.asset">
        <field name="key">theme_dataliza.dz_industry_beam_js</field>
        <field name="name">Dataliza industry card beam interaction</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_dataliza/static/src/interactions/dz_industry_beam.js</field>
    </record>
</odoo>
