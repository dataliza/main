<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_finkok_timbre_wizard_view_form" model="ir.ui.view">
        <field name="name">partner.finkok.timbre.wizard.form</field>
        <field name="model">partner.finkok.timbre.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultar timbres">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_consultar"
                            string="Consultar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
