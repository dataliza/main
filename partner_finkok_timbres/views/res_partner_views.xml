<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_finkok_timbres" model="ir.ui.view">
        <field name="name">res.partner.form.finkok.timbres</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Timbres" name="finkok_timbres">
                    <group>
                        <group>
                            <field name="finkok_timbres_vendidos"/>
                            <field name="finkok_timbres_consumidos" readonly="1"/>
                            <field name="finkok_uso_porcentaje" readonly="1"
                                     widget="progressbar"/>
                        </group>
                    </group>
                    <div class="mb-3">
                        <button name="action_open_finkok_timbre_wizard"
                                type="object"
                                string="Consultar timbres"
                                class="btn-primary"
                                invisible="not id"/>
                    </div>
                    <separator string="RFCs"/>
                    <field name="finkok_rfc_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="rfc"/>
                        </list>
                    </field>
                    <separator string="Historial de consultas"/>
                    <field name="finkok_timbre_history_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="rfc"/>
                            <field name="total"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="create_date" string="Fecha consulta"/>
                            <field name="query_batch" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
